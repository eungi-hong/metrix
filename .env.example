# ---------------------------------------------------------------- database
# Postgres is the system of record. This value is for running the app on your
# host against the compose database (published on 5433 to avoid colliding with a
# local Postgres); docker-compose overrides it with `db:5432` internally,
# so you do not need to change it to run `docker compose up`.
DATABASE_URL=postgresql+asyncpg://metrix:metrix@localhost:5433/metrix

# --------------------------------------------------------------------- llm
# `anthropic` is the only provider implemented today. The knobs below are
# provider-neutral; the credential under them is named for its vendor.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# Required for LLM relevance scoring, competitor resolution, and /chat.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------------- news
# `exa` is the default. Set to `fixture` to run the whole pipeline offline
# with deterministic synthetic articles and no news API key.
NEWS_PROVIDER=exa
# Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=
NEWS_HTTP_TIMEOUT_SECONDS=30
NEWS_MAX_RETRIES=3

# ------------------------------------------------------- movement detection
# A day is major when |return| >= max(MOVEMENT_FLOOR_PCT, MOVEMENT_K * rolling_std)
MOVEMENT_STD_WINDOW=20          # trading days in the rolling volatility window
MOVEMENT_K=2.0                  # standard deviations
MOVEMENT_FLOOR_PCT=0.02         # absolute floor, as a fraction (0.02 = 2%)

# --------------------------------------------------------------- ingestion
PRICE_HISTORY_DAYS=365          # trailing window of prices to pull
PRICE_BATCH_SIZE=100            # symbols per batched yfinance download
PREWARM_PRICE_LOOKBACK_DAYS=45  # days re-fetched for tickers that already have prices
NEWS_WINDOW_DAYS_BEFORE=3       # search articles from N days before a movement
NEWS_WINDOW_DAYS_AFTER=1        # ... to N days after
MAX_MOVEMENTS_PER_INGEST=10     # caps news/LLM spend per run, biggest moves first
MAX_CANDIDATES_PER_TIER=8       # candidate articles per tier per movement
RELEVANCE_MIN_SCORE=0.35        # articles below this are not linked
STALENESS_HOURS=24              # data older than this is refetched on request
NEWS_WINDOW_GRACE_HOURS=6       # the news window counts as closed this long after its last day
NEWS_MAX_ATTEMPTS=3             # stop auto-retrying a movement's news after this many attempts
NEWS_CACHE_CLOSED_WINDOW_TTL_DAYS=90  # cached news for a closed window never changes
NEWS_CACHE_OPEN_WINDOW_TTL_HOURS=2    # ... for a window still open, refetch soon
PEERS_TTL_DAYS=30               # TTL for the LLM-resolved competitor list

# --------------------------------------------------------- demand / universe
# The nightly pre-warm covers: the seed list, the PREWARM_TOP_N most popular
# tickers, and anything requested in the last PREWARM_RECENT_DAYS -- minus
# tickers whose last ingestion failed permanently (e.g. unknown symbol).
DEMAND_HALF_LIFE_DAYS=7         # a request counts half as much a week later
# Comma-separated, always warmed, e.g. AAPL,MSFT. (An empty value takes no
# inline comment: dotenv would read the comment as the value.)
PREWARM_SEED_SYMBOLS=
PREWARM_SEED_FILE=data/seed_universe.txt  # optional, one symbol per line
PREWARM_TOP_N=200
PREWARM_RECENT_DAYS=14

# ---------------------------------------------------------- nightly pre-warm
PREWARM_SCHEDULE_ENABLED=true   # worker schedules the nightly run (safe in every replica)
PREWARM_RUN_AT=17:15            # Mon-Fri, after the 16:00 close has settled
PREWARM_TIMEZONE=America/New_York
PREWARM_JITTER_SECONDS=60       # scheduled jobs start within +/- this of their time
PREWARM_MAX_ENRICHMENTS_PER_RUN=300  # news+LLM enrichments one nightly run may spend
# Required (as the X-Admin-Token header) by every /admin endpoint: users and
# keys, pre-warm, queue, usage. Leave unset to disable them.
ADMIN_TOKEN=

# ------------------------------------------------------------------- identity
# /tickers, /chat, /jobs and /conversations need `Authorization: Bearer mtx_...`.
# Create the first key with: python scripts/create_api_key.py --name "You"
AUTH_REQUIRED=true              # false: callers without a key are anonymous, keyed by IP (dev only)
TRUSTED_PROXY_COUNT=0           # reverse proxies that append to X-Forwarded-For; 0 ignores the header
API_KEY_TOUCH_INTERVAL_MINUTES=5  # how often a key's last_used_at may be written
# Browser origins permitted to call the API. Keep empty for same-origin deployments.
# For the Vite frontend in frontend/, use: http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Also allow origins matching this regex (matched in full), for preview deploys
# whose URL changes per push. Project-specific, never .*\.vercel\.app, e.g.
# CORS_ALLOWED_ORIGIN_REGEX=^https://metrix-[a-z0-9-]+-eungi-hong\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEX=

# ------------------------------------------------------------------- quotas
# Per user (or per IP for anonymous callers). Override any field of any plan;
# the rest keep their defaults. Plans: anonymous, free, pro, internal. Fields:
# requests_per_minute, chat_per_minute, chat_per_day, cold_ingests_per_day,
# refresh_per_day, allow_wait. Defaults: README, "Quotas".
# e.g. PLAN_LIMITS_JSON={"free": {"chat_per_day": 20}}
PLAN_LIMITS_JSON=
API_MAX_INLINE_INGESTIONS=2     # wait=true requests running inline at once, per API process

# ------------------------------------------------------- abuse controls
# A symbol must be in the US symbol directory (Nasdaq Trader's files, refreshed
# weekly by the worker) before anything external is called for it.
SYMBOL_DIRECTORY_MODE=enforce   # enforce (404 unknown), warn (serve, log), off; enforce acts as warn while empty
# Foreign listings are not in a US directory: allow them here, in Yahoo's form.
# e.g. SYMBOL_ALLOWLIST=RY.TO,VOD.L
SYMBOL_ALLOWLIST=
SYMBOL_DIRECTORY_MIN_ROWS=5000  # a refresh with fewer is assumed broken; the old directory stays
SYMBOL_DIRECTORY_MAX_SHRINK=0.2 # ... as is one that would drop more than this fraction of it
DEMAND_ANONYMOUS_WEIGHT=0.25    # demand per anonymous caller per symbol per day (a user's is 1)
DEMAND_INTERNAL_WEIGHT=0        # the internal plan's traffic is not demand
REFRESH_COOLDOWN_MINUTES=60     # refresh=true this soon after the last ingestion serves stored data

# -------------------------------------------------------------------- redis
# Shared counters for the quotas. Unset: per-process counters, with a warning.
# docker-compose sets redis://redis:6379/0 for its containers.
REDIS_URL=redis://localhost:6380/0
REDIS_TIMEOUT_SECONDS=0.25      # a slow Redis falls back rather than slowing every request
REDIS_RETRY_SECONDS=5           # after a failure, per-process counters this long before retrying
LIMITER_FALLBACK_LOG_SECONDS=60 # limiter_fallback is logged at most this often

# -------------------------------------------------------------------- spend
# Every Exa search and LLM call is recorded in usage_events and counted
# against a daily cap (UTC). See docs/FAIRNESS.md.
#
# LLM prices, USD per million tokens, per model id. PLACEHOLDER, left
# commented on purpose: copy the real numbers from the provider's pricing
# page, then uncomment. (Zeros would price every call at $0, and the cap would
# never trip.) A model missing here is recorded at the fallback rates below,
# flagged cost_estimated=true, and logged loudly at startup.
# LLM_PRICES_JSON={"claude-sonnet-4-6": {"input_per_mtok": <in>, "output_per_mtok": <out>, "cache_read_per_mtok": <cache read>, "cache_write_per_mtok": <cache write>}}
LLM_FALLBACK_INPUT_PER_MTOK=20    # not a price: pessimistic, so an unpriced model overcounts
LLM_FALLBACK_OUTPUT_PER_MTOK=100
EXA_COST_ESTIMATE_USD=0.05        # per search, when Exa returns no costDollars; set from your Exa usage
# Most the service may spend per UTC day. Required when APP_ENV=prod; unset
# means unlimited, with a warning at startup.
DAILY_SPEND_CAP_USD=
BACKGROUND_SPEND_SHARE=0.6        # nightly/background work may use this much of the cap; the rest is for users
SPEND_ALERT_FRACTION=0.8          # log spend_threshold_crossed once a day at this fraction of the cap
SPEND_RESUME_JITTER_SECONDS=300   # jobs held by the cap resume within this long after 00:00 UTC

# -------------------------------------------------------------- rate limits
# ACCOUNT-WIDE: shared through Redis by the API and every worker, so set them
# to the provider's own limit, not a per-process slice.
EXA_MAX_RPS=5
ANTHROPIC_MAX_RPM=50
YFINANCE_MAX_RPS=2
BACKGROUND_RATE_SHARE=0.6       # background work may use this much of each rate; the rest stays free for users
RATE_LIMIT_MAX_WAIT_SECONDS=60  # a background call waits at most this for its slot, then the job is retried later
RATE_LIMIT_INTERACTIVE_MAX_WAIT_SECONDS=5  # a user waits at most this, then gets 503 + Retry-After
EXPECTED_PROCESSES=2            # API + workers; with Redis down each process limits itself to rate / this

# --------------------------------------------------------------- job queue
# Ingestion nobody waits on runs as a queued job in the worker (`python -m
# app.worker`, or the `worker` compose service).
JOB_MAX_ATTEMPTS=3              # attempts per job before it is marked dead
JOB_RETRY_BASE_SECONDS=30       # first retry delay; doubles per attempt, with jitter
JOB_RETRY_MAX_SECONDS=1800      # ceiling on one retry delay
JOB_LOCK_TIMEOUT_MINUTES=10     # a running job not heartbeated for this long is requeued
JOB_HEARTBEAT_SECONDS=30        # how often a worker refreshes its running jobs' locks
JOB_REAP_INTERVAL_SECONDS=60    # how often a worker looks for orphaned jobs
JOB_ERROR_MAX_CHARS=2000        # last_error is truncated to this

# ------------------------------------------------------------------ worker
WORKER_CONCURRENCY=4            # concurrent jobs per worker process
WORKER_INTERACTIVE_SLOTS=1      # of those, reserved for priority-0 (a user is waiting)
WORKER_POLL_INTERVAL_SECONDS=2  # idle sleep when the queue is empty ...
WORKER_POLL_JITTER_SECONDS=1    # ... plus up to this much, so loops do not poll in step
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30  # on SIGTERM, time for in-flight jobs before release

# -------------------------------------------------------------------- chat
CHAT_MAX_MOVEMENTS_IN_CONTEXT=12
CHAT_MAX_ARTICLES_PER_MOVEMENT=4
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_MOVEMENT_SUMMARIES=60

# ----------------------------------------------------------------- runtime
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false
