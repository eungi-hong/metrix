# Production variables for the Railway services. Set them on the Railway
# project as shared variables (both services read the same settings). No real
# values here: secrets are entered in the Railway dashboard and nowhere else.
# Every comment sits on its own line, so the file can be pasted into Railway's
# raw editor without a comment becoming part of a value. See docs/DEPLOYMENT.md.
#
# Anything not listed keeps its default from app/core/config.py.

# ----------------------------------------------------------------- runtime
# prod refuses to start without DAILY_SPEND_CAP_USD.
APP_ENV=prod
# info shows every structlog event the runbook mentions.
LOG_LEVEL=info
# One JSON object per line, searchable in Railway's log view.
LOG_JSON=true

# ------------------------------------------------- data stores (references)
# Railway reference to the Postgres service; postgresql:// is upgraded to asyncpg.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway reference to the Redis service: quotas and shared provider rate limits.
REDIS_URL=${{Redis.REDIS_URL}}
# Both services: the API's pre-deploy command migrates, once per deploy.
SKIP_MIGRATIONS=1

# --------------------------------------------------------------- providers
# The only provider implemented.
LLM_PROVIDER=anthropic
# Must have an entry in LLM_PRICES_JSON below, or calls are costed at the fallback rate.
LLM_MODEL=claude-sonnet-4-6
# Secret. A key used only by this deployment (console.anthropic.com > API keys).
ANTHROPIC_API_KEY=
# Real news; `fixture` would serve synthetic articles.
NEWS_PROVIDER=exa
# Secret. A key used only by this deployment (dashboard.exa.ai > API keys).
EXA_API_KEY=

# ------------------------------------------------------------------- spend
# The most Exa and the LLM may cost per UTC day. Must be > 0.
DAILY_SPEND_CAP_USD=3
# The nightly pre-warm may use $1.80 of it; $1.20 stays for visitors.
BACKGROUND_SPEND_SHARE=0.6
# Logs spend_threshold_crossed once a day at $2.40.
SPEND_ALERT_FRACTION=0.8
# USD per million tokens, from https://platform.claude.com/docs/en/about-claude/pricing
# (Claude Sonnet 4.6, read 2026-10-09; re-check before setting). cache_write is
# the 5-minute rate; the app sets no cache_control, so it is unused today.
LLM_PRICES_JSON={"claude-sonnet-4-6": {"input_per_mtok": 3, "output_per_mtok": 15, "cache_read_per_mtok": 0.3, "cache_write_per_mtok": 3.75}}
# Reserved against the cap before each search; what is recorded is Exa's own
# costDollars. https://exa.ai/pricing: auto search $7/1k, text and summary $1/1k
# pages each, 8 results: about $0.023 a search. Rounded up.
EXA_COST_ESTIMATE_USD=0.03

# ---------------------------------------------------------------- identity
# Keyless visitors are served on the anonymous plan below, keyed by IP.
AUTH_REQUIRED=false
# Keyless visitors read pre-warmed data and nothing else: new tickers,
# refreshes and chat cost money and need the demo key. A warm ticker with news
# still owed serves its stored data, with a warning.
PLAN_LIMITS_JSON={"anonymous": {"cold_ingests_per_day": 0, "refresh_per_day": 0, "chat_per_minute": 0, "chat_per_day": 0, "allow_wait": false}}
# Measured with GET /admin/request-info after the first deploy; 0 until then.
# A number, never blank: an empty value stops the app at startup.
TRUSTED_PROXY_COUNT=0
# Secret. Generate with `openssl rand -hex 32`; keep it in a password manager.
ADMIN_TOKEN=

# -------------------------------------------------------------------- CORS
# The Vercel production origin, e.g. https://metrix.vercel.app (no trailing slash).
CORS_ALLOWED_ORIGINS=
# Preview deployments, matched in full. Copy the project and scope slug from a
# real preview URL, e.g. ^https://metrix-[a-z0-9-]+-<scope-slug>\.vercel\.app$
# Never a pattern any Vercel app would match, such as .*\.vercel\.app.
CORS_ALLOWED_ORIGIN_REGEX=

# ---------------------------------------------------------------- pre-warm
# Warmed every weekday night, demand or not.
PREWARM_SEED_SYMBOLS=NVDA,AAPL,TSLA,MSFT,AMZN
# No seed file: the default, data/seed_universe.txt, would add about 40 more.
# A path that is not a file is skipped; not blank, which a host may drop.
PREWARM_SEED_FILE=/dev/null
# Plus the 5 most requested tickers.
PREWARM_TOP_N=5
# Plus anything requested this week.
PREWARM_RECENT_DAYS=7
# News+LLM enrichments per night. Re-size from /admin/usage so a run fits in $1.80.
PREWARM_MAX_ENRICHMENTS_PER_RUN=15
# Unknown symbols are 404 before any paid call, once the weekly refresh has run.
SYMBOL_DIRECTORY_MODE=enforce

# ---------------------------------------------------- worker and rate limits
# One worker process; rate limits are account-wide, shared through Redis.
# Jobs at once in the one worker.
WORKER_CONCURRENCY=3
# One loop kept free for jobs a visitor is waiting on.
WORKER_INTERACTIVE_SLOTS=1
# On SIGTERM; the worker service drains for 45s on Railway, longer than this.
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
# The API and the worker: each takes half the rate while Redis is down.
EXPECTED_PROCESSES=2
# Exa's per-account limit; lower it if your plan's is lower.
EXA_MAX_RPS=5
# Anthropic's per-account limit at the lowest usage tier.
ANTHROPIC_MAX_RPM=50
# Yahoo limits by IP, and both services share Railway's egress.
YFINANCE_MAX_RPS=2
